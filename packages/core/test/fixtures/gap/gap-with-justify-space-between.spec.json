      { "id": "b", "style": { "width": 10, "height": 5 } },
      { "id": "c", "style": { "width": 10, "height": 5 } }
    ]
  },
  "expected": {
    "root": { "left": 0, "top": 0, "width": 60, "height": 5 },
    "a": { "left": 0, "top": 0, "width": 10, "height": 5 },
    "b": { "left": 25, "top": 0, "width": 10, "height": 5 },
    "c": { "left": 50, "top": 0, "width": 10, "height": 5 }
  }
