{
  "name": "aspect-ratio/with-flex-grow",
  "tags": ["aspect-ratio"],
  "root": {
    "id": "root",
    "style": { "flexDirection": "row", "alignItems": "flex-start", "width": 60, "height": 20 },
    "children": [
      { "id": "a", "style": { "width": 10, "height": 10 } },
      { "id": "b", "style": { "width": 20, "aspectRatio": 2 } }
    ]
  },
  "expected": {
    "root": { "left": 0, "top": 0, "width": 60, "height": 20 },
    "a":    { "left": 0, "top": 0, "width": 10, "height": 10 },
    "b":    { "left": 10, "top": 0, "width": 20, "height": 10 }
  }
}
