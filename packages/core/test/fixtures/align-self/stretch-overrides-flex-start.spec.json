{
  "name": "align-self/stretch-overrides-flex-start",
  "tags": ["align-self"],
  "root": {
    "id": "root",
    "style": { "flexDirection": "row", "alignItems": "flex-start", "width": 40, "height": 10 },
    "children": [
      { "id": "a", "style": { "width": 10, "height": 4 } },
      { "id": "b", "style": { "width": 10, "alignSelf": "stretch" } }
    ]
  },
  "expected": {
    "root": { "left": 0, "top": 0, "width": 40, "height": 10 },
    "a": { "left": 0, "top": 0, "width": 10, "height": 4 },
    "b": { "left": 10, "top": 0, "width": 10, "height": 10 }
  }
}
